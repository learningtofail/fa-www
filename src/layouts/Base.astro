---
import "../styles/tokens.css";
import "../styles/site.tokens.css";
interface Props {
  title: string;
  description?: string;
}
const { title, description = "faysal's desktop." } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <!-- No-SEO / block-bots decision, Phase 8 — set from day one rather than bolted on later -->
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <!-- OG/Twitter card: no-index doesn't mean no-preview — Phase 8's Cloudflare
         rule explicitly exempts link-preview bots, so this is what actually
         renders when the URL is shared in Slack/iMessage/LinkedIn. -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:image" content={new URL("/og-image.png", Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL("/og-image.png", Astro.site)} />
    <style is:global>
      :root {
        color-scheme: dark;
      }
      html,
      body {
        margin: 0;
        padding: 0;
        height: 100%;
        background: var(--wallpaper-stop-1);
      }
      * {
        box-sizing: border-box;
      }
      body {
        font-family: var(--font-ui);
        font-size: var(--font-size-root);
        line-height: var(--line-height-body);
        color: var(--text);
        -webkit-font-smoothing: antialiased;
        text-wrap: pretty;
      }
      /* Links sit inside body text and the link color is under 3:1 against it,
         so the underline is the non-color cue WCAG 1.4.1 requires (axe: link-in-text-block). */
      a {
        color: var(--link);
        text-decoration: underline;
        text-underline-offset: 0.15em;
      }
      a:hover {
        text-decoration-thickness: 2px;
      }
      a:visited {
        color: var(--link-visited);
      }
      :focus-visible {
        outline: 2px solid var(--orchis-accent);
        outline-offset: 2px;
      }
      code,
      pre,
      kbd {
        font-family: var(--font-terminal);
      }
      /* ToolsFolderContent renders inside both shells, so its hover state
         lives here rather than being duplicated in desktop.css/mobile.css. */
      .tool-tile:hover {
        background: color-mix(in srgb, currentColor 8%, transparent);
      }
    </style>
  </head>
  <body>
    <slot />
  </body>
</html>
